# Copy this file to `.env` and fill in your ICICI Direct Breeze credentials.
# The session token changes DAILY - generate it from:
# https://api.icicidirect.com/apiuser/login?api_key=<URL-encoded BREEZE_API_KEY>
BREEZE_API_KEY=your_api_key_here
BREEZE_API_SECRET=your_api_secret_here
BREEZE_SESSION_TOKEN=your_daily_session_token_here
